{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashion.local/contracts/events/order-events.schema.json",
  "title": "order.events payloads (03 §5.2/5.3)",
  "description": "status stays a string here; the order state machine (06) and its enum belong to the ORD producer task.",
  "$defs": {
    "OrderLifecycle": {
      "type": "object",
      "required": ["order_id", "order_no", "user_id", "status", "order_version", "items", "total_amount", "currency", "method"],
      "properties": {
        "order_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "order_no": {"type": "string", "minLength": 1, "maxLength": 32},
        "user_id": {"$ref": "common.schema.json#/$defs/nullable_uuid"},
        "status": {"type": "string", "minLength": 1, "maxLength": 32},
        "order_version": {"$ref": "common.schema.json#/$defs/business_version"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/order_item"}
        },
        "total_amount": {"$ref": "common.schema.json#/$defs/vnd_amount"},
        "currency": {"$ref": "common.schema.json#/$defs/currency"},
        "method": {"$ref": "common.schema.json#/$defs/payment_method"}
      }
    },
    "OrderState": {
      "description": "ORDER_CREATED, ORDER_CONFIRMED, ORDER_PAID",
      "$ref": "#/$defs/OrderLifecycle",
      "unevaluatedProperties": false
    },
    "OrderCancelled": {
      "$ref": "#/$defs/OrderLifecycle",
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1}
      },
      "unevaluatedProperties": false
    }
  }
}
