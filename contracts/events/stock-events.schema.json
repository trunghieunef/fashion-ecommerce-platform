{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashion.local/contracts/events/stock-events.schema.json",
  "title": "inventory.events stock snapshot and reservation payloads (03 §5.2/5.3)",
  "description": "reserved <= on_hand and available = on_hand - reserved are producer invariants (05 CHECK); JSON Schema cannot express them, INV-01 tests must.",
  "$defs": {
    "StockSnapshot": {
      "description": "INVENTORY_UPDATED, INVENTORY_RESTOCKED (0 to positive)",
      "type": "object",
      "required": ["sku", "on_hand", "reserved", "available", "stock_version", "observed_at"],
      "properties": {
        "sku": {"$ref": "common.schema.json#/$defs/sku"},
        "on_hand": {"$ref": "common.schema.json#/$defs/stock_quantity"},
        "reserved": {"$ref": "common.schema.json#/$defs/stock_quantity"},
        "available": {"$ref": "common.schema.json#/$defs/stock_quantity"},
        "stock_version": {"$ref": "common.schema.json#/$defs/business_version"},
        "observed_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"}
      },
      "additionalProperties": false
    },
    "ReservationLifecycle": {
      "description": "INVENTORY_RESERVED, INVENTORY_DEDUCTED, INVENTORY_RELEASED (release, expire or tombstone; see status)",
      "type": "object",
      "required": ["order_id", "order_no", "reservation_id", "status", "expires_at", "items", "reason", "version"],
      "properties": {
        "order_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "order_no": {"type": "string", "minLength": 1, "maxLength": 32},
        "reservation_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "status": {"enum": ["ACTIVE", "COMMITTED", "RELEASED", "EXPIRED"]},
        "expires_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "properties": {
              "sku": {"$ref": "common.schema.json#/$defs/sku"},
              "quantity": {"type": "integer", "minimum": 1, "maximum": 99}
            },
            "additionalProperties": false
          }
        },
        "reason": {"type": ["string", "null"], "maxLength": 500},
        "version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    }
  }
}
