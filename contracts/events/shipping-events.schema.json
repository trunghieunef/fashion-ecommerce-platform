{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fashion.local/contracts/events/shipping-events.schema.json",
  "title": "shipping.events shipment payloads (03 §5.2/5.3)",
  "description": "SHIPMENT_CREATED (SHP-01), SHIPMENT_STATUS_UPDATED and COD_COLLECTED/COD_REMITTED (SHP-02). handed_over_at stays null until hand-over is confirmed; COD movements are financial events, never inferred from DELIVERED.",
  "$defs": {
    "ShipmentStatus": {
      "description": "SHIPMENT_CREATED and SHIPMENT_STATUS_UPDATED: order identifiers, carrier, tracking, status, hand-over and version",
      "type": "object",
      "required": ["order_id", "order_no", "shipment_id", "carrier", "tracking_code", "status", "handed_over_at", "provider_occurred_at", "shipment_version"],
      "properties": {
        "order_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "order_no": {"type": "string", "minLength": 1, "maxLength": 32},
        "shipment_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "carrier": {"enum": ["SELF"]},
        "tracking_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "status": {"enum": ["PENDING", "UNKNOWN", "CREATED", "PICKING", "DELIVERING", "DELIVERED", "FAILED", "RETURNING", "RETURNED", "CANCEL_PENDING", "CANCELLED", "MANUAL"]},
        "handed_over_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
        "provider_occurred_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/utc_timestamp"}, {"type": "null"}]},
        "shipment_version": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "CodMovement": {
      "description": "COD_COLLECTED (shipper collected the full cod_amount) and COD_REMITTED (shipper handed the cash to the shop); REMITTED is not proof the money reached the bank (03 section 5.3)",
      "type": "object",
      "required": ["order_id", "order_no", "payment_id", "shipment_id", "event_ref", "gross_amount", "fee_amount", "net_amount", "currency", "evidence_ref", "occurred_at"],
      "properties": {
        "order_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "order_no": {"type": "string", "minLength": 1, "maxLength": 32},
        "payment_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/uuid"}, {"type": "null"}]},
        "shipment_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "event_ref": {"$ref": "common.schema.json#/$defs/uuid"},
        "gross_amount": {"$ref": "common.schema.json#/$defs/vnd_amount"},
        "fee_amount": {"$ref": "common.schema.json#/$defs/vnd_amount"},
        "net_amount": {"$ref": "common.schema.json#/$defs/vnd_amount"},
        "currency": {"const": "VND"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "occurred_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"}
      },
      "additionalProperties": false
    }
  }
}
