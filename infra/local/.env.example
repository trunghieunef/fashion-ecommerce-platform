# Synthetic local-only credentials. Copy to infra/local/.env and do not reuse outside local development.
CATALOG_POSTGRES_DB=catalog
CATALOG_POSTGRES_ADMIN_USERNAME=catalog_admin
CATALOG_POSTGRES_ADMIN_PASSWORD=catalog_admin_local
CATALOG_POSTGRES_PORT=5432

CATALOG_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_MIGRATION_DB_USERNAME=catalog_migration
CATALOG_MIGRATION_DB_PASSWORD=catalog_migration_local

CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_DB_USERNAME=catalog_runtime
CATALOG_DB_PASSWORD=catalog_runtime_local
CATALOG_DB_MAX_POOL_SIZE=10
# Internal quote caller public keys (kid:base64-X.509); empty until cart/order exist.
CATALOG_INTERNAL_CALLERS=

# TASK:CAT-03 local RustFS only. local-up.sh generates these credentials once;
# never use local credentials or the RustFS image in staging/production.
CATALOG_S3_ACCESS_KEY=
CATALOG_S3_SECRET_KEY=
CATALOG_S3_REGION=us-east-1
# Browser-facing URL for presigned uploads (Compose sets the internal endpoint http://rustfs:9000).
CATALOG_S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
CATALOG_S3_QUARANTINE_RETENTION_DAYS=2

# user-service (TASK:USR-01a): database `users`, separate roles.
USER_MIGRATION_DB_PASSWORD=user_migration_local
USER_DB_PASSWORD=user_runtime_local
# TASK:INV-01: generated once into ignored .env by local-up.sh.
INVENTORY_MIGRATION_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
# TASK:CART-01: generated by scripts/local-up.sh.
CART_MIGRATION_DB_PASSWORD=
CART_DB_PASSWORD=
# TASK:CART-01: generated by scripts/local-up.sh; private key stays in this file only.
CART_SERVICE_PRIVATE_KEY=
CART_SERVICE_PUBLIC_KEY=
# TASK:CART-03: caller:base64-X.509 for cart /internal (snapshot/cleanup); only order-service:<base64> (ORD-01).
# Để trống mặc định (mọi call internal 401); chỉ thêm public key caller đã xác minh, không private key/token.
CART_INTERNAL_CALLERS=
# TASK:SHP-01: generated by scripts/local-up.sh (role passwords, caller key pair for catalog quote).
SHIPPING_MIGRATION_DB_PASSWORD=
SHIPPING_DB_PASSWORD=
SHIPPING_SERVICE_PRIVATE_KEY=
SHIPPING_SERVICE_PUBLIC_KEY=
# caller:base64-X.509 for shipping /internal (quotes, shipments); only order-service:<base64> (ORD-01). Empty = 401.
SHIPPING_INTERNAL_CALLERS=
# TASK:PAY-01: role passwords generated by scripts/local-up.sh.
PAYMENT_MIGRATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
# caller:base64-X.509 for payment /internal (create, by-order, close); only order-service:<base64> (ORD-02). Empty = 401.
PAYMENT_INTERNAL_CALLERS=
# TASK:PAY-02: VNPay sandbox merchant. Để trống = VNPAY tắt; điền ở infra/local/.env, không commit.
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_HASH_SECRET=
# TASK:ORD-01: order-service DB roles and ADR-19 caller key (local-up generates; caller of cart/catalog/shipping).
ORDER_MIGRATION_DB_PASSWORD=
ORDER_DB_PASSWORD=
ORDER_SERVICE_PRIVATE_KEY=
ORDER_SERVICE_PUBLIC_KEY=
# TASK:NOT-01: notification-service DB roles and ADR-19 caller key (local-up generates; caller of user internal secrets).
NOTIFICATION_MIGRATION_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_SERVICE_PRIVATE_KEY=
NOTIFICATION_SERVICE_PUBLIC_KEY=
# Guest checkout token: cart signs (PKCS#8 base64), order verifies (kid:base64-X.509); quote HMAC secret (base64).
CART_CHECKOUT_PRIVATE_KEY=
CART_CHECKOUT_KID=cart-checkout-1
ORDER_CHECKOUT_PUBLIC_KEYS=
ORDER_QUOTE_SECRET=
# caller:base64-X.509,...; order-service:<base64> cần cho reservations (ORD-02).
# Để trống mặc định; chỉ thêm public key caller đã xác minh, không private key/token.
INVENTORY_INTERNAL_CALLERS=
# Access-token signing key (Base64 PKCS#8 EC P-256). Left empty on purpose:
# scripts/local-up.sh generates a local-only key into infra/local/.env (gitignored).
USER_JWT_PRIVATE_KEY=
USER_JWT_KEY_ID=user-local
# Verifier keys (ADR-21), kid:base64-X.509; local-up.sh derives it from the private key.
USER_JWT_PUBLIC_KEYS=
# First SUPER_ADMIN (USR-02b): email of an already registered account; applied at user-service
# startup only while no SUPER_ADMIN exists. Empty disables it.
USER_BOOTSTRAP_ADMIN_EMAIL=
# USR-01b: Redis password (local-only placeholder) and AES-256 master for reset encryption
# and a derived quota HMAC key. USER_SECRET_KEY is empty: local-up.sh generates it into .env.
USER_REDIS_PASSWORD=redis_local
# TASK:CAT-02b: generated by scripts/local-up.sh; catalog Redis ACL user (cache only).
CATALOG_REDIS_PASSWORD=
USER_SECRET_KEY=
# Quota key namespace; keep separate Redis/credentials per environment.
FASHION_ENV=local
# ADR-19 callers allowed on /internal (service:base64-X.509). Empty until notification exists.
USER_INTERNAL_CALLERS=

# Published on 127.0.0.1 only. Catalog has no published port in Compose.
GATEWAY_PORT=8080
STOREFRONT_PORT=4173

# Nacos (profile nacos-compat only). Synthetic local-only values.
NACOS_AUTH_TOKEN=czEtbG9jYWwtc3ludGhldGljLW5hY29zLXRva2VuLWtleS0wMDAx # gitleaks:allow
NACOS_AUTH_IDENTITY_KEY=s1-local-identity
NACOS_AUTH_IDENTITY_VALUE=s1-local-identity-value
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos_local_admin
# TASK:PLT-05: local trace viewer (Grafana -> Explore -> Tempo) and sampling for every service.
TRACING_SAMPLING_PROBABILITY=1.0
GRAFANA_PORT=3000
TEMPO_PORT=3200
