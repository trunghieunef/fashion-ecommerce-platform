# Synthetic local-only credentials. Copy to infra/local/.env and do not reuse outside local development.
CATALOG_POSTGRES_DB=catalog
CATALOG_POSTGRES_ADMIN_USERNAME=catalog_admin
CATALOG_POSTGRES_ADMIN_PASSWORD=catalog_admin_local
CATALOG_POSTGRES_PORT=5432

CATALOG_MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_MIGRATION_DB_USERNAME=catalog_migration
CATALOG_MIGRATION_DB_PASSWORD=catalog_migration_local

CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_DB_USERNAME=catalog_runtime
CATALOG_DB_PASSWORD=catalog_runtime_local
CATALOG_DB_MAX_POOL_SIZE=10

# user-service (TASK:USR-01a): database `users`, separate roles.
USER_MIGRATION_DB_PASSWORD=user_migration_local
USER_DB_PASSWORD=user_runtime_local
# Access-token signing key (Base64 PKCS#8 EC P-256). Left empty on purpose:
# scripts/local-up.sh generates a local-only key into infra/local/.env (gitignored).
USER_JWT_PRIVATE_KEY=
USER_JWT_KEY_ID=user-local
# Verifier keys (ADR-21), kid:base64-X.509; local-up.sh derives it from the private key.
USER_JWT_PUBLIC_KEYS=
# First SUPER_ADMIN (USR-02b): email of an already registered account; applied at user-service
# startup only while no SUPER_ADMIN exists. Empty disables it.
USER_BOOTSTRAP_ADMIN_EMAIL=

# Published on 127.0.0.1 only. Catalog has no published port in Compose.
GATEWAY_PORT=8080
STOREFRONT_PORT=4173

# Nacos (profile nacos-compat only). Synthetic local-only values.
NACOS_AUTH_TOKEN=czEtbG9jYWwtc3ludGhldGljLW5hY29zLXRva2VuLWtleS0wMDAx
NACOS_AUTH_IDENTITY_KEY=s1-local-identity
NACOS_AUTH_IDENTITY_VALUE=s1-local-identity-value
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos_local_admin
